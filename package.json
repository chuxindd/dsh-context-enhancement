{
  "name": "dsh-context-enhancement",
  "description": "Persistent task state and context-aware compaction for DeepSeek Harness coding sessions.",
  "version": "0.1.11",
  "license": "MIT",
  "author": "chuxindd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chuxindd/dsh-context-enhancement.git"
  },
  "homepage": "https://github.com/chuxindd/dsh-context-enhancement#readme",
  "bugs": {
    "url": "https://github.com/chuxindd/dsh-context-enhancement/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "profile-bundle",
    "task-state",
    "compaction"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./task-state": {
      "types": "./lib/types/task-state.d.ts",
      "default": "./lib/task-state.js"
    },
    "./task-state-basic": {
      "types": "./lib/types/task-state-basic.d.ts",
      "default": "./lib/task-state-basic.js"
    },
    "./task-state-control": {
      "types": "./lib/types/task-state-control.d.ts",
      "default": "./lib/task-state-control.js"
    },
    "./task-state-prompt": {
      "types": "./lib/types/task-state-prompt.d.ts",
      "default": "./lib/task-state-prompt.js"
    },
    "./compaction-basic": {
      "types": "./lib/types/compaction-basic.d.ts",
      "default": "./lib/compaction-basic.js"
    },
    "./tool-result-pruner": {
      "types": "./lib/types/tool-result-pruner.d.ts",
      "default": "./lib/tool-result-pruner.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/task-state.js",
    "lib/task-state-basic.js",
    "lib/task-state-control.js",
    "lib/task-state-prompt.js",
    "lib/compaction-basic.js",
    "lib/tool-result-pruner.js",
    "lib/client.js",
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "assets",
    "cordis.patch.yml",
    "presets",
    "scripts/install-desktop-preset.mjs",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "./lib/task-state.js",
    "./lib/task-state-basic.js",
    "./lib/task-state-control.js",
    "./lib/task-state-prompt.js",
    "./lib/compaction-basic.js",
    "./lib/tool-result-pruner.js"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "clean:lib": "node scripts/clean-lib.mjs",
    "build": "node scripts/clean-lib.mjs && tsc -p tsconfig.build.json && tsdown --config-loader tsx && node scripts/patch-client-id.mjs",
    "build:lib": "node scripts/clean-lib.mjs && tsc -p tsconfig.build.json && tsdown --config-loader tsx && node scripts/patch-client-id.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:check": "node scripts/release-check.mjs",
    "pack:artifact": "npm pack",
    "verify:artifact": "node scripts/verify-artifact-parity.mjs",
    "verify:install": "node scripts/verify-profile-install.mjs",
    "install:desktop-preset": "node scripts/install-desktop-preset.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-json": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.2-rc.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "18.3.1",
    "js-yaml": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
